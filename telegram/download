from __future__ import annotations

import asyncio
import logging

from telegram import Update
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

from app.config import Settings
from app.models import EventType, TelegramEvent

logger = logging.getLogger(__name__)


class TelegramBotStreamer:
    """Listens for Telegram messages and pushes TelegramEvents into a queue."""

    def __init__(self, settings: Settings, queue: asyncio.Queue[TelegramEvent]) -> None:
        self.settings = settings
        self.queue = queue
        self.app = (
            Application.builder()
            .token(settings.telegram_bot_token)
            .build()
        )
        # Register handlers — commands first, then everything else.
        self.app.add_handler(CommandHandler("start", self._handle_start))
        self.app.add_handler(MessageHandler(filters.ALL, self._handle_message))

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------
    @staticmethod
    def _detect_type(update: Update) -> EventType:
        msg = update.effective_message
        if msg is None:
            return "other"
        if msg.text and msg.text.startswith("/"):
            return "command"
        if msg.text:
            return "text"
        if msg.photo:
            return "photo"
        if msg.document:
            return "document"
        if msg.voice:
            return "voice"
        if msg.video:
            return "video"
        if msg.sticker:
            return "sticker"
        return "other"

    def _build_event(self, update: Update) -> TelegramEvent | None:
        msg = update.effective_message
        if msg is None:
            return None

        user = update.effective_user
        return TelegramEvent(
            message_id=msg.message_id,
            event_type=self._detect_type(update),
            chat_id=msg.chat_id,
            user_id=user.id if user else None,
            username=user.username if user else None,
            first_name=user.first_name if user else None,
            text=msg.text,
            caption=msg.caption,
            date=msg.date.timestamp() if msg.date else 0.0,
        )

    def _user_allowed(self, event: TelegramEvent) -> bool:
        allowed = self.settings.telegram_allowed_user_ids
        if not allowed:
            return True
        return event.user_id is not None and event.user_id in allowed

    def _matches_keywords(self, event: TelegramEvent) -> bool:
        keywords = self.settings.telegram_topic_keywords
        if not keywords:
            return True
        content = event.content.lower()
        return any(kw in content for kw in keywords)

    # ------------------------------------------------------------------
    # Handlers
    # ------------------------------------------------------------------
    async def _handle_start(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
        user = update.effective_user
        uid = user.id if user else "unknown"
        await update.message.reply_text(  # type: ignore[union-attr]
            f"✅ Bot is running!\n\nYour user ID is: `{uid}`\n\n"
            "Add this ID to TELEGRAM_ALLOWED_USER_IDS in .env to restrict access.",
            parse_mode="Markdown",
        )

    async def _handle_message(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
        event = self._build_event(update)
        if event is None:
            return

        if not self._user_allowed(event):
            logger.debug("Ignored message from non-allowed user %s", event.user_id)
            return

        if not self._matches_keywords(event):
            logger.debug("Ignored message (no keyword match): %s", event.content[:80])
            return

        await self.queue.put(event)
        logger.info(
            "Queued msg=%s type=%s from=%s",
            event.message_id,
            event.event_type,
            event.username or event.user_id,
        )

    # ------------------------------------------------------------------
    # Run
    # ------------------------------------------------------------------
    async def run(self) -> None:
        logger.info("Telegram bot starting (long-polling) …")
        await self.app.initialize()
        await self.app.start()
        await self.app.updater.start_polling(drop_pending_updates=True)  # type: ignore[union-attr]

        # Block forever until cancelled.
        stop_event = asyncio.Event()
        try:
            await stop_event.wait()
        except asyncio.CancelledError:
            pass
        finally:
            await self.app.updater.stop()  # type: ignore[union-attr]
            await self.app.stop()
            await self.app.shutdown()
